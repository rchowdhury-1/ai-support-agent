# SupportAI v2 backend environment
NODE_ENV=development
PORT=5001

# v2-dev Neon branch, supportai_v2 database. NEVER the v1 production endpoint —
# the boot guard (src/db/guard.ts) refuses it. Production hosts must be listed
# in PROD_DB_HOSTS and only work with NODE_ENV=production.
DATABASE_URL=postgresql://user:password@ep-your-v2-dev-branch.eu-west-2.aws.neon.tech/supportai_v2?sslmode=require
# PROD_DB_HOSTS=ep-your-v2-prod-endpoint

# Web app origin (Next.js app that proxies /api, /auth, /billing)
CLIENT_URL=http://localhost:3141

JWT_SECRET=change-me-32-chars-minimum-secret
REFRESH_SECRET=change-me-32-chars-minimum-secret

# Generation (Anthropic) + embeddings (OpenAI)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Stripe (per-tenant subscriptions + customer portal)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email (payment links); optional in dev
RESEND_API_KEY=re_...
